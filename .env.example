APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# TiDB Cloud (Serverless) is the shared database for this project. It speaks the
# MySQL protocol, so DB_CONNECTION stays `mysql` and no extra PHP driver is
# needed beyond pdo_mysql.
#
# Get these from the TiDB Cloud console: Cluster > Connect > "General" tab.
# The username is prefixed with the cluster id, e.g. 4KmzKfKNbxxxxxx.root
#
# TiDB Cloud Serverless requires TLS. The CA is Let's Encrypt ISRG Root X1,
# committed to storage/certs/isrgrootx1.pem. Use an ABSOLUTE path here —
# PDO does not resolve relative ones.
DB_CONNECTION=mysql
DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=hims
DB_USERNAME=<cluster-prefix>.root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA="D:/HIMS/HIMS/storage/certs/isrgrootx1.pem"

# Local offline fallback — swap these two lines in if you need to work without
# a network. The database file is no longer tracked, so create an empty
# `supply_chain` file first, then run `php artisan migrate --seed`.
# DB_CONNECTION=sqlite
# DB_DATABASE=supply_chain

SESSION_DRIVER=database
SESSION_LIFETIME=4
SESSION_WARNING_SECONDS=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Gmail SMTP uses MAIL_SCHEME=smtp, MAIL_HOST=smtp.gmail.com, and MAIL_PORT=587.
# Use a 16-character Google app password without display spaces; never commit it.
# Keep MAIL_FROM_ADDRESS equal to MAIL_USERNAME unless using a verified alias.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
AUTH_PASSWORD_RESET_OTP_EXPIRE=5
AUTH_LOGIN_MFA_OTP_EXPIRE=5
AUTH_LOGIN_MFA_MAX_ATTEMPTS=5
AUTH_LOGIN_MFA_RESEND_COOLDOWN=60
AUTH_PASSWORD_EXPIRATION_DAYS=90
# Keep this secret stable after password history is enabled. When omitted,
# Laravel's APP_KEY is used as the one-way password fingerprint key.
AUTH_PASSWORD_HISTORY_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
