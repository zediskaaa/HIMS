{
  "openapi": "3.0.0",
  "info": {
    "title": "HIMS Supply Chain API",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec for Inventory & Supply Chain endpoints"
  },
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "summary": "Issue API token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {"type": "string"},
                  "password": {"type": "string"},
                  "device_name": {"type": "string"}
                },
                "required": ["email","password"]
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Token issued"},
          "401": {
            "description": "Invalid credentials with server-derived attempts remaining",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"},
                    "attempts_remaining": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          },
          "428": {"description": "MFA verification or password renewal is required through the matching web login panel"},
          "429": {
            "description": "Progressive login wait or temporary account lock is active",
            "headers": {
              "Retry-After": {
                "description": "Seconds until another login attempt is allowed",
                "schema": {"type": "integer"}
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"},
                    "code": {"type": "string", "enum": ["LOGIN_THROTTLED", "LOGIN_LOCKED"]},
                    "retry_after": {"type": "integer", "minimum": 1},
                    "retry_at": {"type": "integer"},
                    "attempts_remaining": {"type": "integer", "nullable": true, "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inventory-items": {
      "get": {
        "summary": "List inventory items",
        "security": [{"bearerAuth":[]}],
        "responses": {"200": {"description": "OK"}}
      },
      "post": {
        "summary": "Create inventory item",
        "security": [{"bearerAuth":[]}],
        "requestBody": {"content": {"application/json": {"schema": {"type":"object"}}}},
        "responses": {"201": {"description": "Created"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "Bearer"}
    }
  }
}
